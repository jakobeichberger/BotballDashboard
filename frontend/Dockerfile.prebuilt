# Used by scripts/proxmox-setup.sh and scripts/update.sh: dist/ is built on the
# host (esbuild cannot spawn its service inside Docker builds on unprivileged
# Proxmox LXC), this image only serves it. Keep the nginx files in sync with
# Dockerfile.
FROM nginx:alpine
COPY dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY security-headers.conf /etc/nginx/snippets/security-headers.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
