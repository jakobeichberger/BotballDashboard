{
  "name": "botball-dashboard-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src e2e playwright.config.ts --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "api:generate": "python3 ../backend/scripts/export_openapi.py --output openapi.json && openapi-typescript openapi.json -o src/api/generated.ts",
    "e2e": "playwright test",
    "test:e2e": "playwright test",
    "e2e:typecheck": "tsc -p e2e/tsconfig.json"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-query-devtools": "^5.103.2",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-resources-to-backend": "^1.2.3",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^0.379.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.88.0",
    "react-i18next": "^14.1.3",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.4",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "zod": "^3.25.76",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^15.0.7",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^24.1.3",
    "openapi-typescript": "7.8.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "serialize-javascript": ">=7.0.5",
      "fast-uri": ">=3.1.2",
      "@babel/core": ">=7.29.6",
      "@babel/plugin-transform-modules-systemjs": ">=7.29.4",
      "form-data": ">=4.0.6",
      "ws": ">=8.21.0",
      "brace-expansion@<2": "^1.1.21",
      "brace-expansion@>=2": ">=5.0.6",
      "js-yaml": ">=4.2.0",
      "esbuild": "^0.25.0",
      "follow-redirects": ">=1.16.0",
      "postcss": ">=8.5.10",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "browserslist@<4.28.7": "^4.28.7",
      "minimatch@9": "^10.2.5"
    }
  }
}
