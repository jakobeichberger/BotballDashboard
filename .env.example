# ─────────────────────────────────────────────────────────────────────────────
# BotballDashboard – environment variables (production template)
#
#   cp .env.example .env
#
# Then replace every value marked REQUIRED. With APP_ENV=production the backend
# refuses to start (error in `docker compose logs backend`) while a REQUIRED
# secret is empty, shorter than 24 characters, contains "change-me", or while
# APP_BASE_URL/ALLOWED_ORIGINS still point to example.com.
#
# Generate secrets:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Generate the Fernet key for PRINTER_CREDENTIAL_ENCRYPTION_KEY:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   (or, with the stack running: make fernet-key)
#
# scripts/proxmox-setup.sh generates this file with all secrets filled in.
# Local development does not need a .env at all (see README).
# ─────────────────────────────────────────────────────────────────────────────

# ── Compose profiles ─────────────────────────
# production = encrypted daily backups (needs AGE_RECIPIENT)
# monitoring = Prometheus, Blackbox exporter, Alertmanager
COMPOSE_PROFILES=production

# ── Application ──────────────────────────────
# development | production
APP_ENV=production
# REQUIRED: random secret, min. 24 characters
APP_SECRET_KEY=
# REQUIRED: public URL and allowed CORS origins (comma-separated)
APP_BASE_URL=https://botball.example.com
ALLOWED_ORIGINS=https://botball.example.com

# ── Traefik / TLS (docker-compose.yml) ───────
# REQUIRED: host name routed by Traefik and Let's Encrypt contact address
DOMAIN=botball.example.com
TRAEFIK_EMAIL=admin@example.com
# Trusted proxies for X-Forwarded-For. The backend is only reachable through
# Traefik, so compose defaults to "*". Uncomment to restrict.
# FORWARDED_ALLOW_IPS=*

# ── Database ─────────────────────────────────
# The backend builds the connection URL from these parts (DATABASE_URL is not
# read – passwords with special characters need no URL encoding).
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=botball
POSTGRES_USER=botball
# REQUIRED: min. 24 characters
POSTGRES_PASSWORD=

# Proxmox LXC without nesting only: uncomment (empty value = TCP only, no Unix
# socket). The database/role must then be created manually – proxmox-setup.sh
# does that.
# POSTGRES_UNIX_SOCKET_DIRECTORIES=

# Store PostgreSQL data in a host directory (bind mount). Leave all three empty
# to use the plain named volume "pgdata".
PGDATA_DRIVER_OPT_TYPE=
PGDATA_DRIVER_OPT_O=
PGDATA_DRIVER_OPT_DEVICE=
# Example (Proxmox setup):
# PGDATA_DRIVER_OPT_TYPE=none
# PGDATA_DRIVER_OPT_O=bind
# PGDATA_DRIVER_OPT_DEVICE=/data/db

# ── Redis ────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ──────────────────────────────────────
# REQUIRED: a second, different random secret, min. 24 characters
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Email (optional) ─────────────────────────
# Empty SMTP_HOST disables SMTP. Used for account-created notices and, if
# configured below, alert e-mails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="BotballDashboard <noreply@example.com>"
SMTP_TLS=true
# Optional fallback when SMTP fails
SENDGRID_API_KEY=
SENDGRID_FROM=

# ── Web Push (optional) ──────────────────────
# `make vapid-keys` creates the private key in the "vapid" volume and prints
# the public key; the frontend must be rebuilt after setting VAPID_PUBLIC_KEY.
VAPID_PRIVATE_KEY=/app/vapid/private_key.pem
VAPID_PUBLIC_KEY=
VAPID_ADMIN_EMAIL=admin@example.com

# ── 3D Print ─────────────────────────────────
# REQUIRED in production: Fernet key (see generation command at the top).
# Encrypts stored printer API credentials; keep it – changing it makes stored
# printer credentials unreadable.
PRINTER_CREDENTIAL_ENCRYPTION_KEY=

# ── File uploads ─────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=20

# ── Backups (profile "production") ───────────
# REQUIRED for backups: age public key (age1...). Create the key pair on a
# trusted machine with `age-keygen -o botball-backup-identity.txt`, keep the
# identity file OFF this server, put only the public key here. Without it every
# backup run fails and the backup container turns unhealthy.
AGE_RECIPIENT=
# Store archives in a host directory instead of the "backups" volume (makes
# off-site copies easy), e.g. /data/backups
# BACKUP_HOST_DIR=/data/backups
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_RETRY_SECONDS=3600
# BACKUP_RETENTION_DAYS=30
# BACKUP_MAX_AGE_HOURS=26

# ── Alerts (profile "monitoring") ────────────
# Alertmanager sends to a webhook and/or by e-mail; SMTP defaults to SMTP_*.
# ALERT_WEBHOOK_URL=https://ntfy.sh/your-private-topic
# ALERT_EMAIL_TO=ops@example.com
# ALERT_EMAIL_FROM=
# ALERT_SMTP_SMARTHOST=mail.example.com:587
# ALERT_SMTP_USER=
# ALERT_SMTP_PASSWORD=
# ALERT_SMTP_REQUIRE_TLS=true

# ── Container logs ───────────────────────────
# json-file rotation for every service
# LOG_MAX_SIZE=10m
# LOG_MAX_FILE=5
